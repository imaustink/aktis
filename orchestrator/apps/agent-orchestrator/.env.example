# Required
OPENAI_API_KEY=
# The Temporal engine gateway every turn is forwarded to (docs/adr/0036).
AGENT_TEMPORAL_ENGINE_URL=http://localhost:8080

# Optional (defaults shown)
# Bearer token presented to the engine gateway (it maps tokens to subject+roles).
# AGENT_TEMPORAL_ENGINE_TOKEN=
# How long one turn's poll may run before reporting a resumable pause (seconds).
# AGENT_RUN_TIMEOUT_SECONDS=28800
# Leave unset. Anything other than "temporal" refuses to start (docs/adr/0053).
# AGENT_ENGINE=
# AGENT_NAMESPACE=default
# AGENT_HTTP_PORT=8081
# AGENT_REDIS_URL=redis://localhost:6379
# AGENT_SESSION_TTL_SECONDS=1800
# AGENT_SESSION_MAX_ENTRIES=1000
# AGENT_INVOCATION_TTL_SECONDS=3600
# AGENT_SHUTDOWN_DRAIN_MS=25000

# Consumer-supplied tools (ADR 0035): their own collection, keyed by content
# hash so identical definitions embed once, ever.
# AGENT_QDRANT_URL=http://localhost:6333
# AGENT_QDRANT_API_KEY=
# AGENT_QDRANT_VECTOR_SIZE=1536
# AGENT_QDRANT_CALLER_TOOLS_COLLECTION=caller_tools
# Max caller tools forwarded to the engine -- also the threshold below which
# the caller-tool index is skipped entirely (nothing to prune).
# AGENT_CALLER_TOOL_TOP_K=5
# Qdrant has no native TTL, so unused definitions are swept on a timer.
# AGENT_CALLER_TOOL_TTL_SECONDS=604800
# AGENT_CALLER_TOOL_PRUNE_INTERVAL_SECONDS=3600
# AGENT_EMBEDDING_MODEL=text-embedding-3-small

# Signs/verifies sender, caller-identity and dispatch assertions. Must match
# integration-gateway's and the engine gateway's.
# AGENT_SENDER_ASSERTION_SECRET=

# Per-user chat identity: Open WebUI's FORWARD_USER_INFO_HEADER_JWT_SECRET.
# AGENT_OPENWEBUI_USER_JWT_SECRET=
# AGENT_OPENWEBUI_USER_ROLES=reader,writer

# Identity-link defaults and the Connections page (ADR 0046).
# IDENTITY_LINK_GATEWAY_URL=
# IDENTITY_LINK_GATEWAY_TOKEN=
# AGENT_DEFAULT_IDENTITY_LINK_FLOW=authcode
# AGENT_CONNECTIONS_URL=

# Caller authentication (README "Caller authentication"): every turn needs a
# bearer token this map resolves, or (chat) a verified Open WebUI user JWT.
# AGENT_CALLER_AUTH=enforce   # or "warn" while confirming callers' tokens
# AGENT_IDENTITY_RESOLVER=static
# AGENT_STATIC_IDENTITIES={"dev-token":{"subject":"dev","roles":["reader"]}}
# AGENT_OIDC_ISSUER=https://issuer.example.com
# AGENT_OIDC_JWKS_URI=https://issuer.example.com/.well-known/jwks.json
# AGENT_OIDC_AUDIENCE=agent-orchestrator
# AGENT_OIDC_ROLES_CLAIM=roles
