{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible and /invoke facade in front of the Temporal agent engine.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-orchestrator": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aktis/event-triggers": "0.1.0",
    "@aktis/messaging": "0.1.0",
    "@kubernetes/client-node": "^1.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@qdrant/js-client-rest": "^1.13.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.0.0"
  }
}
