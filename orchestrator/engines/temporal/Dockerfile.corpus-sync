FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/corpus-sync ./cmd/corpus-sync

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/corpus-sync /corpus-sync
USER 65532:65532
ENTRYPOINT ["/corpus-sync"]
